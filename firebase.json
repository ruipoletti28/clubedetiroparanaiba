{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run lint"]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/assets/archives/Regulamento_Abate.pdf",
        "destination": "/regulamentos.html",
        "type": 301
      },
      {
        "source": "/assets/archives/Regulamento_W2C.pdf",
        "destination": "/regulamentos.html",
        "type": 301
      },
      {
        "source": "/favicon.ico",
        "destination": "/favicon.svg",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/pdfjs/**",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
      },
      {
        "source": "**/*.@(css|js|svg|jpg|png|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      }
    ]
  }
}
